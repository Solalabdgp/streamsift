# === Telegram bot (notifier, Bot API) ===
BOT_TOKEN=
# твой числовой id, узнать через @userinfobot
OWNER_TELEGRAM_ID=0

# === Infra ===
DATABASE_URL=postgresql+asyncpg://jobradar:jobradar@postgres:5432/jobradar
DATABASE_URL_SYNC=postgresql+psycopg2://jobradar:jobradar@postgres:5432/jobradar
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=jobradar
POSTGRES_DB=jobradar
REDIS_URL=redis://redis:6379/0

# === Логика скоринга ===
NOTIFY_THRESHOLD=10
GREY_LOW=8
GREY_HIGH=15
STACK_SCORE_CAP=9
HIRING_SCORE_CAP=8
NOISE_PENALTY_CAP=-8

# === ML (этап 3, выключено пока не накопится разметка) ===
ML_ENABLED=false
ML_THRESHOLD=0.5
ML_MIN_SAMPLES=150
ML_MODEL_DIR=/data/models

# === Общее ===
MAX_MESSAGE_AGE_MIN=180
SOURCE_BACKFILL_DAYS=7
QUIET_HOURS_START=23:00
QUIET_HOURS_END=08:00
TZ=Asia/Almaty
RULES_VERSION=v1
LOG_LEVEL=INFO
